# Python
__pycache__/
*.pyc
*.pyo

# Model checkpoints are regenerated by training (see README); config-G is the exception.
*.pt
!sva/checkpoints/**

# Downloaded corpora + regenerated checkpoints
data/cache/

# Intermediate checkpoint subdirs under results/ (JSONs ship; checkpoints do not)
results/**/ckpt/

# results/lm_5pt_runs/: ship the small per-seed JSONs (they back Table 4's
# d_osc=4,16 oscillator rows for both datasets) and the aggregation scripts.
# The regenerated .pt checkpoints stay ignored via the *.pt rule above; logs stay out.
results/lm_5pt_runs/logs/

# Local backups / scratch
*.backup-*
*.bak-*
.DS_Store

# Superseded pre-reorganization trees + scratch (kept on disk, never tracked)
experiments/
exploration/
rebuttal2026/

# A reader's own runs. results/ is the reference -- the run behind the paper -- and
# drivers write here instead, so a re-run lands beside it rather than over it.
runs/

# Regenerated figure PDFs (build artifacts; paper figures live in the paper repo)
figures/output/
# Diagnostic plots drivers emit while running -- not paper figures
figures/diagnostics/

# Figure 5 (TinyStories demo) reproducibility: ship only the d_osc=2 demo checkpoint + vocab
!figures/lib/models/TS_d2.pt
!figures/lib/cache/vocab_ts.pt

# TinyStories LM eval reproducibility: ship the authoritative vocab + val chunks
# that match the released LM checkpoints (train chunks are regenerated, never shipped).
!data/tinystories_eval/
!data/tinystories_eval/vocab.pt
